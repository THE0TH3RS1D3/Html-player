<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Pocket Arcade</title>
<script>
try{var m=localStorage.getItem('pa-theme')||'auto';
document.documentElement.dataset.theme=(m==='dark'||(m==='auto'&&matchMedia('(prefers-color-scheme: dark)').matches))?'dark':'light'}catch(e){}
</script>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Arcade">
<meta name="theme-color" content="#ece8f5">
<style>
:root{
  color-scheme:light;
  --bg:#ece8f5; --ink:#1d1730; --muted:#6b6483; --card:#fff; --blue:#2f3cff; --butter:#ffd84d; --line:#d6cfe6;
  --chip:#f3f0fa; --danger:#c2185b; --bar:#1d1730;
  --font: ui-rounded, "SF Pro Rounded", system-ui, -apple-system, "Segoe UI", sans-serif;
}
:root[data-theme="dark"]{
  color-scheme:dark;
  --bg:#15111f; --ink:#efeaff; --muted:#a79fc2; --card:#211b30; --blue:#5b66ff; --line:#352d4b;
  --chip:#2d2542; --danger:#ff6b9a; --bar:#15111f;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;height:100%}
body{background:var(--bg);color:var(--ink);font-family:var(--font);
  padding:env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left)}
main{max-width:640px;margin:0 auto;padding:20px 16px 48px}
body::before{content:"";position:fixed;top:0;left:0;right:0;height:env(safe-area-inset-top);background:var(--bar);z-index:5}
.top{display:flex;align-items:center;justify-content:space-between;gap:12px}
.pill{border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:999px;padding:8px 14px;font:600 .85rem var(--font);cursor:pointer}
h1{font-size:2rem;line-height:1.1;margin:8px 0 4px;letter-spacing:-.02em}
.sub{color:var(--muted);margin:0 0 20px;line-height:1.4}
.add{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;padding:16px;border:0;border-radius:18px;
  background:var(--blue);color:#fff;font:700 1.05rem var(--font);cursor:pointer}
.add:active{transform:scale(.98)}
.add input{display:none}
.msg{min-height:1.4em;margin:10px 2px;font-size:.9rem;color:var(--muted)}
.msg.err{color:var(--danger)}
ul{list-style:none;margin:8px 0 0;padding:0;display:grid;gap:10px}
li{display:flex;align-items:center;gap:12px;background:var(--card);border:1px solid var(--line);border-radius:16px;padding:10px}
.tile{flex:none;width:52px;height:52px;border-radius:12px;display:grid;place-items:center;font-weight:800;font-size:1.4rem;color:#fff}
.play{flex:1;min-width:0;text-align:left;background:none;border:0;padding:6px 4px;font:inherit;color:inherit;cursor:pointer}
.play b{display:block;font-size:1.05rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.play small{color:var(--muted)}
.icon{flex:none;border:0;background:var(--chip);color:var(--ink);border-radius:10px;padding:10px 12px;font:600 .85rem var(--font);cursor:pointer}
.icon.del{color:var(--danger)}
.empty{text-align:center;color:var(--muted);padding:36px 12px;border:2px dashed var(--line);border-radius:16px;line-height:1.5}
.tip{margin-top:28px;font-size:.85rem;color:var(--muted);line-height:1.5}

/* player */
#player{position:fixed;left:0;top:0;width:100%;height:100vh;height:100lvh;background:#000;z-index:10;display:none}
#player.on{display:block}
#frame{position:absolute;inset:0;width:100%;height:100%;border:0;background:#fff}
#menuBtn{position:absolute;left:0;top:0;width:40px;height:40px;border-radius:50%;border:0;padding:0;
  background:rgba(29,23,48,.6);color:#fff;font:700 18px var(--font);opacity:.5;z-index:2;cursor:grab;
  touch-action:none;-webkit-user-select:none;user-select:none;transition:opacity .15s;
  -webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px)}
#menuBtn.active{opacity:1}
#menu{position:absolute;display:none;z-index:3;background:var(--card);border-radius:14px;padding:6px;
  box-shadow:0 8px 30px rgba(0,0,0,.35);min-width:170px}
#menu.on{display:block}
#menu button{display:block;width:100%;text-align:left;border:0;background:none;padding:12px 14px;font:600 1rem var(--font);color:var(--ink);border-radius:10px}
#menu button:active{background:var(--chip)}
#menu button[hidden]{display:none}
#menu small{display:block;padding:4px 14px 8px;color:var(--muted);font-size:.75rem}
html.playing,body.playing{background:#000}
body.playing{overflow:hidden;position:fixed;width:100%}
</style>
</head>
<body>
<main>
  <div class="top"><h1>Pocket Arcade</h1><button id="theme" class="pill" type="button"></button></div>
  <p class="sub">Import HTML games from your phone and play them full screen. Everything stays on this device.</p>

  <label class="add">
    Import HTML or ZIP files
    <input id="file" type="file" multiple accept=".html,.htm,.zip,text/html,application/zip">
  </label>
  <div id="msg" class="msg" role="status"></div>

  <ul id="list"></ul>

  <p class="tip">Tip: in Safari tap Share, then Add to Home Screen. Opened from the home screen, games run without the browser bars. Games made of several files (scripts, images, sounds in folders) work too: zip the game folder and import the .zip.</p>
</main>

<div id="player" aria-label="Game">
  <iframe id="frame" title="Game"
    allow="autoplay; fullscreen; gamepad; accelerometer; gyroscope; clipboard-write"
    sandbox="allow-scripts allow-same-origin allow-forms allow-modals allow-pointer-lock allow-popups allow-downloads"></iframe>
  <button id="menuBtn" aria-label="Game menu">&#8942;</button>
  <div id="menu">
    <button id="reload">Restart game</button>
    <button id="fitBtn">Fit to screen: Off</button>
    <button id="rotBtn" hidden>Rotate sideways: Off</button>
    <button id="sizeBtn" hidden>Game size</button>
    <button id="exit">Back to library</button>
    <small>Drag the round button to move it</small>
  </div>
</div>

<script>
(function(){
  var DB='pocket-arcade', STORE='games', db;
  var $=function(id){return document.getElementById(id)};
  var list=$('list'), msg=$('msg'), current=null;

  function open(){
    return new Promise(function(res,rej){
      var r=indexedDB.open(DB,2);
      r.onupgradeneeded=function(){
        var d=r.result;
        if(!d.objectStoreNames.contains(STORE)) d.createObjectStore(STORE,{keyPath:'id',autoIncrement:true});
        if(!d.objectStoreNames.contains('files')) d.createObjectStore('files');
      };
      r.onsuccess=function(){res(r.result)};
      r.onerror=function(){rej(r.error)};
    });
  }
  function tx(mode,fn){
    return new Promise(function(res,rej){
      var t=db.transaction(STORE,mode), s=t.objectStore(STORE), out=fn(s);
      t.oncomplete=function(){res(out&&out.result)};
      t.onerror=t.onabort=function(){rej(t.error)};
    });
  }
  var all=function(){return tx('readonly',function(s){return s.getAll()})};
  var get=function(id){return tx('readonly',function(s){return s.get(id)})};
  var put=function(g){return tx('readwrite',function(s){return s.put(g)})};
  var del=function(id){return tx('readwrite',function(s){return s.delete(id)})};
  function putFiles(id,files){
    return new Promise(function(res,rej){
      var t=db.transaction('files','readwrite'), s=t.objectStore('files');
      files.forEach(function(f){s.put({type:f.type,data:f.data},id+'/'+f.path)});
      t.oncomplete=res; t.onerror=t.onabort=function(){rej(t.error)};
    });
  }
  function delFiles(id){
    return new Promise(function(res,rej){
      var t=db.transaction('files','readwrite');
      t.objectStore('files').delete(IDBKeyRange.bound(id+'/',id+'/\uffff'));
      t.oncomplete=res; t.onerror=t.onabort=function(){rej(t.error)};
    });
  }

  /* ---- zip support (no libraries: own reader + built-in DecompressionStream) ---- */
  var MIME={html:'text/html',htm:'text/html',css:'text/css',js:'text/javascript',mjs:'text/javascript',json:'application/json',
    png:'image/png',jpg:'image/jpeg',jpeg:'image/jpeg',gif:'image/gif',webp:'image/webp',svg:'image/svg+xml',ico:'image/x-icon',
    mp3:'audio/mpeg',ogg:'audio/ogg',wav:'audio/wav',m4a:'audio/mp4',mp4:'video/mp4',webm:'video/webm',
    woff:'font/woff',woff2:'font/woff2',ttf:'font/ttf',otf:'font/otf',txt:'text/plain',xml:'application/xml',wasm:'application/wasm',map:'application/json'};
  function mime(p){return MIME[p.split('.').pop().toLowerCase()]||'application/octet-stream'}

  function inflate(bytes){
    var s=new Blob([bytes]).stream().pipeThrough(new DecompressionStream('deflate-raw'));
    return new Response(s).arrayBuffer();
  }
  async function readZip(buf){
    if(typeof DecompressionStream==='undefined') throw new Error('needs iOS 16.4 or newer to unzip');
    var dv=new DataView(buf), u8=new Uint8Array(buf), dec=new TextDecoder(), i=buf.byteLength-22, out=[];
    for(;i>=0&&dv.getUint32(i,true)!==0x06054b50;i--);
    if(i<0) throw new Error('not a valid zip');
    var count=dv.getUint16(i+10,true), p=dv.getUint32(i+16,true);
    for(var n=0;n<count;n++){
      if(dv.getUint32(p,true)!==0x02014b50) break;
      var method=dv.getUint16(p+10,true), csize=dv.getUint32(p+20,true),
          nl=dv.getUint16(p+28,true), el=dv.getUint16(p+30,true), cl=dv.getUint16(p+32,true), off=dv.getUint32(p+42,true);
      var name=dec.decode(u8.subarray(p+46,p+46+nl));
      p+=46+nl+el+cl;
      if(name.slice(-1)==='/'||/(^|\/)(__MACOSX|\.DS_Store)/.test(name)) continue;
      var start=off+30+dv.getUint16(off+26,true)+dv.getUint16(off+28,true);
      var raw=u8.subarray(start,start+csize), data;
      if(method===0) data=raw.slice().buffer;
      else if(method===8) data=await inflate(raw);
      else throw new Error('unsupported compression');
      out.push({path:name,data:data,type:mime(name)});
    }
    return out;
  }
  function stripRoot(files){
    var first=files[0].path.split('/')[0]+'/';
    if(files.every(function(f){return f.path.indexOf(first)===0&&f.path.length>first.length}))
      files.forEach(function(f){f.path=f.path.slice(first.length)});
  }
  function findEntry(files){
    var h=files.filter(function(f){return /\.html?$/i.test(f.path)});
    var isIdx=function(f){return /(^|\/)index\.html?$/i.test(f.path)?1:0};
    h.sort(function(a,b){return (a.path.split('/').length-b.path.split('/').length)||(isIdx(b)-isIdx(a))});
    return h.length?h[0].path:null;
  }
  function gunzip(buf){
    var s=new Blob([buf]).stream().pipeThrough(new DecompressionStream('gzip'));
    return new Response(s).arrayBuffer();
  }
  // Unity WebGL builds: .gz files normally rely on a server header that tells the browser to
  // unpack them. Here we unpack them once at import and serve them with the right type.
  async function unityFix(files){
    var unity=files.some(function(f){return /(\.loader\.js|UnityLoader\.js)$/i.test(f.path)});
    if(!unity) return false;
    for(var k=0;k<files.length;k++){
      var f=files[k];
      if(/\.br$/i.test(f.path)) throw new Error('Unity build uses Brotli compression. Re-export with Gzip, or with Decompression Fallback on');
      if(/\.gz$/i.test(f.path)){
        var h=new Uint8Array(f.data,0,2);
        if(h[0]===0x1f&&h[1]===0x8b) f.data=await gunzip(f.data);
        f.type=mime(f.path.slice(0,-3));
      }
    }
    return true;
  }
  async function importZip(f,i){
    var files=await readZip(await f.arrayBuffer());
    if(!files.length) throw new Error('zip is empty');
    stripRoot(files);
    var unity=await unityFix(files);
    var entry=findEntry(files);
    if(!entry) throw new Error('no HTML file inside');
    var html=new TextDecoder().decode(files.filter(function(x){return x.path===entry})[0].data);
    var id=await put({title:titleOf(html,f.name.replace(/\.zip$/i,'')),kind:'zip',unity:unity,entry:entry,size:f.size,added:Date.now()+i});
    try{await putFiles(id,files)}catch(e){await del(id);throw e}
  }

  function say(t,err){msg.textContent=t||'';msg.className='msg'+(err?' err':'')}
  function esc(s){return s.replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
  function hue(s){var h=0;for(var i=0;i<s.length;i++)h=(h*31+s.charCodeAt(i))%360;return h}
  function size(n){return n>1048576?(n/1048576).toFixed(1)+' MB':Math.max(1,Math.round(n/1024))+' KB'}

  function titleOf(html,fallback){
    var m=html.match(/<title[^>]*>([\s\S]*?)<\/title>/i);
    var t=m&&m[1].trim();
    return t||fallback.replace(/\.(html?|HTML?)$/,'');
  }

  async function render(){
    var games=(await all()).sort(function(a,b){return b.added-a.added});
    if(!games.length){
      list.innerHTML='<li class="empty" style="display:block">No games yet. Tap Import and choose one from Files, iCloud Drive or Downloads.</li>';
      return;
    }
    list.innerHTML=games.map(function(g){
      var letter=esc((g.title.trim()[0]||'?').toUpperCase());
      return '<li data-id="'+g.id+'">'+
        '<div class="tile" style="background:hsl('+hue(g.title)+' 62% 46%)">'+letter+'</div>'+
        '<button class="play" data-act="play"><b>'+esc(g.title)+'</b><small>'+(g.kind==='zip'?(g.unity?'Unity game, ':'Zip game, '):'')+size(g.size)+'</small></button>'+
        '<button class="icon" data-act="rename">Rename</button>'+
        '<button class="icon del" data-act="del">Delete</button></li>';
    }).join('');
  }

  $('file').addEventListener('change',async function(e){
    var files=Array.prototype.slice.call(e.target.files||[]), ok=0, bad=[];
    for(var i=0;i<files.length;i++){
      var f=files[i];
      try{
        if(/\.zip$/i.test(f.name)||f.type==='application/zip'){
          await importZip(f,i);
        }else{
          var text=await f.text();
          if(!/<\w+/.test(text)) throw new Error('not html');
          await put({title:titleOf(text,f.name),html:text,size:f.size,added:Date.now()+i});
        }
        ok++;
      }catch(err){bad.push(f.name+' ('+(err.message||'error')+')')}
    }
    e.target.value='';
    say(ok?('Added '+ok+' '+(ok===1?'game':'games')+'.'):'', false);
    if(bad.length) say('Could not read: '+bad.join(', '),true);
    render();
  });

  list.addEventListener('click',async function(e){
    var b=e.target.closest('button'); if(!b) return;
    var li=b.closest('li'), id=Number(li.dataset.id), act=b.dataset.act;
    if(act==='play') play(id);
    if(act==='rename'){
      var g=await get(id), n=prompt('Rename game',g.title);
      if(n&&n.trim()){g.title=n.trim();await put(g);render()}
    }
    if(act==='del'){
      var g2=await get(id);
      if(confirm('Delete "'+g2.title+'" from this device?')){await del(id);if(g2.kind==='zip')await delFiles(id);render()}
    }
  });

  var player=$('player'), frame=$('frame'), menu=$('menu');
  async function launch(g){
    if(g.kind==='zip'){
      if(!('serviceWorker' in navigator)){say('This browser cannot run zip games.',true);return false}
      await navigator.serviceWorker.ready;
      if(!navigator.serviceWorker.controller){say('Almost ready: close and reopen the app once, then try again.',true);return false}
      frame.removeAttribute('srcdoc');
      frame.src='play/'+g.id+'/'+g.entry.split('/').map(encodeURIComponent).join('/');
    }else{
      frame.removeAttribute('src');
      frame.srcdoc=g.html;
    }
    return true;
  }
  async function play(id){
    var g=await get(id); if(!g) return;
    current=g;
    player.classList.add('on'); document.body.classList.add('playing'); document.documentElement.classList.add('playing');
    menu.classList.remove('on'); relayout();
    if(!(await launch(g))) exit();
  }
  function blank(){frame.removeAttribute('srcdoc');frame.src='about:blank'}
  function exit(){
    blank();
    player.classList.remove('on'); document.body.classList.remove('playing'); document.documentElement.classList.remove('playing');
    menu.classList.remove('on'); current=null; frame.style.cssText='';
  }
  /* draggable menu button */
  var btn=$('menuBtn'), M=6, TOP0=50, BOT0=40, btnPos={x:1,y:.5}, drag=null;
  try{var sp=JSON.parse(localStorage.getItem('pa-btn')||'null');if(sp&&isFinite(sp.x)&&isFinite(sp.y))btnPos=sp}catch(e){}
  function clamp(v){return Math.min(1,Math.max(0,v))}
  function applyPos(){
    var w=btn.offsetWidth||40, h=btn.offsetHeight||40;
    btn.style.left=(M+btnPos.x*Math.max(0,PW()-w-2*M))+'px';
    btn.style.top=(TOP0+btnPos.y*Math.max(0,PH()-h-TOP0-BOT0))+'px';
  }
  function setFromPx(l,t){
    var w=btn.offsetWidth, h=btn.offsetHeight;
    btnPos.x=clamp((l-M)/Math.max(1,PW()-w-2*M));
    btnPos.y=clamp((t-TOP0)/Math.max(1,PH()-h-TOP0-BOT0));
    applyPos();
  }
  function positionMenu(){
    var r=btn.getBoundingClientRect(), mw=menu.offsetWidth, mh=menu.offsetHeight;
    var left=(r.left+r.width/2>PW()/2)?r.right-mw:r.left;
    var top=(r.top+r.height/2>PH()/2)?r.top-mh-8:r.bottom+8;
    menu.style.left=Math.max(6,Math.min(left,PW()-mw-6))+'px';
    menu.style.top=Math.max(6,Math.min(top,PH()-mh-6))+'px';
  }
  function toggleMenu(){
    if(menu.classList.toggle('on')){refreshMenu();positionMenu()}
  }
  btn.addEventListener('pointerdown',function(e){
    btn.setPointerCapture(e.pointerId);
    var r=btn.getBoundingClientRect();
    drag={dx:e.clientX-r.left,dy:e.clientY-r.top,sx:e.clientX,sy:e.clientY,moved:false};
    btn.classList.add('active');
  });
  btn.addEventListener('pointermove',function(e){
    if(!drag) return;
    if(!drag.moved&&Math.hypot(e.clientX-drag.sx,e.clientY-drag.sy)>8){drag.moved=true;menu.classList.remove('on')}
    if(drag.moved) setFromPx(e.clientX-drag.dx,e.clientY-drag.dy);
  });
  btn.addEventListener('pointerup',function(){
    if(!drag) return;
    if(drag.moved){
      btnPos.x=btnPos.x<.5?0:1; applyPos();
      try{localStorage.setItem('pa-btn',JSON.stringify(btnPos))}catch(e){}
    }else toggleMenu();
    drag=null; btn.classList.remove('active');
  });
  btn.addEventListener('pointercancel',function(){drag=null;btn.classList.remove('active')});
  function PW(){return player.clientWidth||innerWidth}
  function PH(){return player.clientHeight||innerHeight}

  /* screen fit (off unless switched on per game) */
  function fitState(){
    if(!current.fit) current.fit={on:false,rot:false,w:current.unity?960:1280,h:current.unity?640:720};
    return current.fit;
  }
  function sizePlayer(){
    // Home Screen apps on some iPhones leave a strip at the bottom outside the page; reach into it.
    var h=innerHeight, w=innerWidth, want=h;
    if(navigator.standalone){
      var sh=(w>=h)?Math.min(screen.width,screen.height):Math.max(screen.width,screen.height);
      if(sh>h&&sh-h<100) want=sh;
    }
    player.style.height=want+'px';
  }
  function layout(){
    if(!current) return;
    var f=fitState();
    if(!f.on){frame.style.cssText='';return}
    var W=PW(), H=PH(), bw=f.rot?f.h:f.w, bh=f.rot?f.w:f.h, sc=Math.min(W/bw,H/bh);
    frame.style.cssText='inset:auto;width:'+f.w+'px;height:'+f.h+'px;left:'+((W-f.w)/2)+'px;top:'+((H-f.h)/2)+
      'px;transform-origin:center center;transform:rotate('+(f.rot?90:0)+'deg) scale('+sc+')';
  }
  function relayout(){sizePlayer();layout();applyPos()}
  function refreshMenu(){
    var f=fitState();
    $('fitBtn').textContent='Fit to screen: '+(f.on?'On':'Off');
    $('rotBtn').hidden=$('sizeBtn').hidden=!f.on;
    $('rotBtn').textContent='Rotate sideways: '+(f.rot?'On':'Off');
    $('sizeBtn').textContent='Game size: '+f.w+'\u00d7'+f.h;
  }
  function fitChanged(){put(current);layout();refreshMenu();positionMenu()}
  $('fitBtn').addEventListener('click',function(){var f=fitState();f.on=!f.on;fitChanged()});
  $('rotBtn').addEventListener('click',function(){var f=fitState();f.rot=!f.rot;fitChanged()});
  $('sizeBtn').addEventListener('click',function(){
    var f=fitState(), v=prompt('Screen size the game was made for (width x height)',f.w+'x'+f.h);
    var m=v&&v.match(/(\d+)\D+(\d+)/);
    if(m&&+m[1]>=100&&+m[2]>=100&&+m[1]<=8000&&+m[2]<=8000){f.w=+m[1];f.h=+m[2];fitChanged()}
  });
  window.addEventListener('resize',function(){if(player.classList.contains('on')){relayout();menu.classList.remove('on')}});
  window.addEventListener('orientationchange',function(){setTimeout(function(){if(player.classList.contains('on'))relayout()},300)});


  /* theme */
  var themeBtn=$('theme'), MODES=['auto','dark','light'], mq=matchMedia('(prefers-color-scheme: dark)');
  function getMode(){try{return localStorage.getItem('pa-theme')||'auto'}catch(e){return 'auto'}}
  function applyTheme(m){
    var dark=m==='dark'||(m==='auto'&&mq.matches);
    document.documentElement.dataset.theme=dark?'dark':'light';
    document.querySelector('meta[name=theme-color]').content=dark?'#15111f':'#ece8f5';
    themeBtn.textContent='Theme: '+m.charAt(0).toUpperCase()+m.slice(1);
  }
  themeBtn.addEventListener('click',function(){
    var m=MODES[(MODES.indexOf(getMode())+1)%3];
    try{localStorage.setItem('pa-theme',m)}catch(e){}
    applyTheme(m);
  });
  if(mq.addEventListener) mq.addEventListener('change',function(){applyTheme(getMode())});
  applyTheme(getMode());
  $('exit').addEventListener('click',exit);
  $('reload').addEventListener('click',function(){
    if(!current) return; menu.classList.remove('on');
    blank(); setTimeout(function(){launch(current)},50);
  });

  // stop page bounce/zoom gestures behind the game
  document.addEventListener('gesturestart',function(e){if(player.classList.contains('on'))e.preventDefault()});

  open().then(function(d){db=d;render()}).catch(function(){
    say('Storage is unavailable (private browsing?). Games cannot be saved here.',true);
  });

  if('serviceWorker' in navigator){navigator.serviceWorker.register('sw.js').catch(function(){})}
})();
</script>
</body>
</html>
